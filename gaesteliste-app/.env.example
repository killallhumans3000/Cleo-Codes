# ============================================================
# Gästelisten-App — Umgebungsvariablen
# Kopiere diese Datei als .env.local und trage deine Werte ein
# ============================================================

# Supabase (https://supabase.com/dashboard/project/<id>/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ACHTUNG: Service Role Key niemals mit NEXT_PUBLIC_ prefixen!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App URL (für QR-Codes und E-Mail-Links)
NEXT_PUBLIC_APP_URL=https://deine-app.vercel.app

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxx

# Absender-E-Mail (muss in Resend verifiziert sein)
EMAIL_FROM=Wohnheim Gästeliste <noreply@deine-domain.de>

# Ticket-Signing-Secret für HMAC-SHA256 QR-Token (mind. 32 Hex-Zeichen)
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ACHTUNG: Ohne NEXT_PUBLIC_ — niemals an den Client weitergeben!
TICKET_SECRET=dein-zufaelliges-32-byte-hex-secret-hier-eintragen
